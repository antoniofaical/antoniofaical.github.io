---
import { publicSocioSecondaryText, publicSocioText } from '../../lib/copy/publicSocioText';

type Amount = {
  displayValue: string;
  scope: string;
  caveat: string;
};

type Layer = {
  id: string;
  label: string;
  perspective: string;
  summary: string;
  amounts: Amount[];
  claimIds: string[];
  limitations: string[];
};

export interface Props {
  title: string;
  summary: string;
  layers: Layer[];
}

const PERSPECTIVE_LABEL: Record<string, string> = {
  payer: 'Pagador',
  'health-system': 'Sistema de saúde',
  patient: 'Paciente',
  societal: 'Sociedade',
};

const { title, summary, layers } = Astro.props;

function perspectiveLabel(value: string): string {
  return PERSPECTIVE_LABEL[value] ?? publicSocioText(value);
}
---

<section id="custos" class="section-space surface-editorial" aria-labelledby="custos-title">
  <div class="container stack stack--lg">
    <header class="stack stack--tight">
      <h2 id="custos-title">{title}</h2>
      <p>{publicSocioText(summary)}</p>
      <p class="limit" role="note">
        Camadas monetárias não devem ser somadas entre moedas, anos ou perspectivas sem normalização
        autorizada pela fonte.
      </p>
    </header>
    <div class="layer-grid">
      {
        layers.map((layer) => (
          <article>
            <h3>{layer.label}</h3>
            <p class="meta">Perspectiva: {perspectiveLabel(layer.perspective)}</p>
            <p>{publicSocioText(layer.summary)}</p>
            <ul>
              {layer.amounts.map((amount) => {
                const caveat = publicSocioSecondaryText(amount.caveat);
                return (
                  <li>
                    <p>
                      <strong>{publicSocioText(amount.displayValue)}</strong>
                      <span> — {publicSocioText(amount.scope)}</span>
                    </p>
                    {caveat ? <p class="limit">{caveat}</p> : null}
                  </li>
                );
              })}
            </ul>
            <p class="limit">
              {layer.limitations.map((item) => publicSocioSecondaryText(item)).join(' ')}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .layer-grid {
    display: grid;
    gap: var(--space-4);
  }

  .layer-grid article {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: var(--border-thin) solid var(--line-200);
  }

  .layer-grid ul {
    margin: var(--space-3) 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-3);
  }

  .meta,
  .limit {
    color: var(--ink-600);
    font-size: var(--annotation);
    max-width: 70ch;
  }

  .limit {
    font-weight: 600;
  }
</style>
