---
import type { MarketSegment } from '../../schemas/socioeconomic/domain';

export interface Props {
  title: string;
  summary: string;
  segments: MarketSegment[];
}

const MATURITY: Record<MarketSegment['maturity'], string> = {
  established: 'Estabelecido',
  emerging: 'Emergente',
  fragmented: 'Fragmentado',
  conceptual: 'Conceitual',
};

const OBS: Record<MarketSegment['observability'], string> = {
  monetary: 'Observabilidade monetária',
  'population-only': 'Somente população potencial',
  'conceptual-only': 'Somente dimensão conceitual',
  absent: 'Ausência de mensuração confiável',
};

const { title, summary, segments } = Astro.props;
---

<section id="segmentos" class="section-space" aria-labelledby="segmentos-title">
  <div class="container stack stack--lg">
    <header class="stack stack--tight">
      <h2 id="segmentos-title">{title}</h2>
      <p>{summary}</p>
    </header>
    <div class="table-wrap" role="region" aria-label="Segmentos de mercado">
      <table>
        <thead>
          <tr>
            <th scope="col">Segmento</th>
            <th scope="col">Beneficiário</th>
            <th scope="col">Comprador/pagador</th>
            <th scope="col">Maturidade</th>
            <th scope="col">Observabilidade</th>
          </tr>
        </thead>
        <tbody>
          {
            segments.map((segment) => (
              <tr>
                <th scope="row">
                  <span>{segment.label}</span>
                  <p class="cell-note">{segment.summary}</p>
                  <p class="limit">{segment.limitations[0]}</p>
                </th>
                <td>{segment.beneficiary.join('; ')}</td>
                <td>{segment.buyerPayer.join('; ')}</td>
                <td>{MATURITY[segment.maturity]}</td>
                <td>{OBS[segment.observability]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .table-wrap {
    overflow-x: auto;
    border: var(--border-thin) solid var(--line-200);
    border-radius: var(--radius-lg);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    padding: var(--space-3);
    text-align: left;
    border-bottom: var(--border-thin) solid var(--line-200);
    vertical-align: top;
  }

  thead th {
    background: var(--paper-100);
  }

  .cell-note,
  .limit {
    margin: var(--space-2) 0 0;
    color: var(--ink-600);
    font-size: var(--annotation);
    font-weight: 500;
    max-width: 36ch;
  }

  .limit {
    font-weight: 600;
  }
</style>
