---
export interface Props {
  eyebrow?: string;
  title: string;
  summary: string;
  notice?: string;
  updatedAt?: string;
  cutoff?: string;
  brandPilot?: boolean;
}

const {
  eyebrow = 'Análise',
  title,
  summary,
  notice,
  updatedAt,
  cutoff,
  brandPilot = false,
} = Astro.props;
---

<header
  class:list={[
    'research-header',
    'section-space',
    brandPilot ? 'research-header--brand' : 'surface-executive',
  ]}
>
  <div class="container stack stack--lg">
    <p class="research-header__eyebrow">{eyebrow}</p>
    <h1 class="research-header__title">{title}</h1>
    <p class="research-header__summary">{summary}</p>
    {
      notice && notice.trim() !== '' && (
        <p class="research-header__notice" role="note">
          {notice}
        </p>
      )
    }
    {
      (updatedAt || cutoff) && (
        <p class="research-header__meta">
          {updatedAt && (
            <>
              Última revisão: <time datetime={updatedAt}>{updatedAt}</time>
            </>
          )}
          {updatedAt && cutoff ? ' · ' : ''}
          {cutoff && (
            <>
              Corte das fontes: <time datetime={cutoff}>{cutoff}</time>
            </>
          )}
        </p>
      )
    }
  </div>
</header>

<style>
  .research-header__eyebrow {
    font-size: var(--annotation);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.85;
    max-width: none;
  }

  .research-header__title {
    font-size: var(--heading-1);
    color: var(--paper-50);
    max-width: 18ch;
    margin: 0;
  }

  .research-header__summary {
    max-width: 62ch;
    opacity: 0.92;
    margin: 0;
  }

  .research-header__notice {
    max-width: 62ch;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--cyan-300);
    background: rgb(246 248 247 / 8%);
  }

  .research-header__meta {
    font-size: var(--annotation);
    opacity: 0.8;
    max-width: none;
    margin: 0;
  }

  .research-header--brand {
    background: var(--einstein-white);
    color: var(--einstein-neutral-700);
  }

  .research-header--brand .research-header__eyebrow {
    color: var(--einstein-blue-dark);
    opacity: 1;
  }

  .research-header--brand .research-header__title {
    color: var(--einstein-neutral-900);
  }

  .research-header--brand .research-header__summary {
    color: var(--einstein-neutral-700);
    opacity: 1;
  }

  .research-header--brand .research-header__notice {
    border-left-color: var(--einstein-blue-medium);
    background: var(--einstein-neutral-50);
    color: var(--einstein-neutral-700);
  }

  .research-header--brand .research-header__meta {
    color: var(--einstein-neutral-700);
    opacity: 1;
  }
</style>
