---
export interface Props {
  limitations: string[];
  sources: Array<{ title: string; path?: string }>;
  claimIds?: string[];
  showMedicalNotice?: boolean;
}

const { limitations, sources, showMedicalNotice = false } = Astro.props;
---

<footer
  class="evidence-footer section-space surface-editorial"
  aria-labelledby="evidence-footer-title"
>
  <div class="container stack stack--lg">
    <h2 id="evidence-footer-title">Limitações e fontes desta página</h2>
    <ul>
      {limitations.map((item) => <li>{item}</li>)}
    </ul>
    <h3>Fontes</h3>
    <ul>
      {
        sources.map((source) => (
          <li>
            <strong>{source.title}</strong>
          </li>
        ))
      }
    </ul>
    {
      showMedicalNotice && (
        <p role="note">Conteúdo informativo. Não substitui avaliação médica individual.</p>
      )
    }
  </div>
</footer>

<style>
  .evidence-footer h2 {
    font-size: var(--heading-2);
  }

  .evidence-footer h3 {
    font-size: var(--heading-3);
  }

  .evidence-footer ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
    color: var(--ink-600);
    max-width: 70ch;
  }

  .evidence-footer p {
    color: var(--ink-600);
    max-width: 70ch;
  }
</style>
