---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageContainer from '../../../components/layout/PageContainer.astro';
import Breadcrumbs from '../../../components/research/Breadcrumbs.astro';
import ResearchHeader from '../../../components/research/ResearchHeader.astro';
import StartupExplorer from '../../../components/startups/StartupExplorer';
import StartupEmptyState from '../../../components/startups/StartupEmptyState';
import StartupCoverageNotice from '../../../components/startups/StartupCoverageNotice';
import ObservatoryAnalytics from '../../../components/startups/ObservatoryAnalytics';
import { loadPublishedSnapshot } from '../../../lib/startups/loadPublishedSnapshot';
import { withBase } from '../../../lib/paths/withBase';
import { startupCoverageStatusLabels } from '../../../data/startups/taxonomies';

const snapshot = loadPublishedSnapshot();
const isEmpty =
  snapshot.coverage.status === 'not-yet-populated' || snapshot.organizations.length === 0;
const updatedAt = snapshot.publishedAt.slice(0, 10);
---

<BaseLayout
  title="Observatório de startups em glicogenoses"
  description="Base curada de organizações com relevância direta, adjacente ou ainda não confirmada às glicogenoses. Base pública estática, sujeita a atualização editorial."
  currentPath={withBase('inovacao/startups/')}
  lastReviewedAt={updatedAt}
>
  <main id="conteudo-principal">
    <div class="container section-space stack stack--lg">
      <Breadcrumbs
        items={[
          { label: 'Início', href: '/' },
          { label: 'Inovação' },
          { label: 'Observatório de startups' },
        ]}
      />
    </div>

    <ResearchHeader
      eyebrow="Observatório"
      title="Observatório de startups em glicogenoses"
      summary="Mapeamento curado — não exaustivo — de organizações com relações diretas, adjacentes e de relevância ainda não confirmada às GSDs."
      updatedAt={updatedAt}
      cutoff={updatedAt}
    />

    <section class="section-space" aria-labelledby="startup-method-note">
      <PageContainer class="stack stack--md">
        <h2 id="startup-method-note">Nota metodológica</h2>
        <ul class="startup-page__notes">
          <li>A base é curada e revisada; não é um censo global de startups.</li>
          <li>
            Os dados públicos são sujeitos a atualização editorial periódica quando uma nova base
            publicada é selecionada.
          </li>
          <li>
            Classificações direta / adjacente / ecossistema / relevância não confirmada e Brasil /
            global pertencem às avaliações de relevância ligadas a cada organização — não são bases
            separadas.
          </li>
          <li>
            Última atualização:{' '}
            <time datetime={snapshot.publishedAt}>{updatedAt}</time>.
          </li>
        </ul>
      </PageContainer>
    </section>

    {
      !isEmpty && (
        <section class="section-space" aria-label="Cobertura da base">
          <PageContainer>
            <StartupCoverageNotice
              statusLabel={startupCoverageStatusLabels[snapshot.coverage.status]}
              summary={snapshot.coverage.summary}
              limitations={snapshot.coverage.limitations}
            />
          </PageContainer>
        </section>
      )
    }

    {
      !isEmpty && (
        <section class="section-space" aria-label="Visão analítica">
          <PageContainer>
            <ObservatoryAnalytics snapshot={snapshot} />
          </PageContainer>
        </section>
      )
    }

    <section class="section-space surface-editorial" aria-labelledby="startup-explorer-title">
      <PageContainer class="stack stack--lg">
        <header class="stack stack--tight">
          <p class="section-kicker">Projeção pública</p>
          <h2 id="startup-explorer-title">Organizações publicadas</h2>
        </header>

        {
          isEmpty ? (
            <StartupEmptyState
              publishedAt={snapshot.publishedAt}
              summary={snapshot.coverage.summary}
              limitations={snapshot.coverage.limitations}
            />
          ) : (
            <StartupExplorer client:load snapshot={snapshot} />
          )
        }
      </PageContainer>
    </section>

    <section class="section-space" aria-labelledby="startup-about-data">
      <PageContainer class="stack stack--md">
        <h2 id="startup-about-data">Sobre os dados</h2>
        <p>
          A base é revisada periodicamente. Quando uma fonte pública está vinculada ao registro, ela
          aparece no detalhe da organização. Alguns registros diretos ainda não possuem uma fonte
          pública vinculada nesta versão.
        </p>
      </PageContainer>
    </section>
  </main>
</BaseLayout>

<style>
  .startup-page__notes {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: var(--space-2);
    color: var(--ink-700);
    max-width: 48rem;
  }
</style>
