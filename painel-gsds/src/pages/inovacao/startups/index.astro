---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/research/Breadcrumbs.astro';
import ResearchHeader from '../../../components/research/ResearchHeader.astro';
import StartupObservatory from '../../../components/startups/StartupObservatory';
import { DEFAULT_GSD_API_BASE_URL } from '../../../lib/startups/startupApi';
import { withBase } from '../../../lib/paths/withBase';

const apiBaseUrl = import.meta.env.PUBLIC_GSD_API_BASE_URL ?? DEFAULT_GSD_API_BASE_URL;
---

<BaseLayout
  title="Observatório de startups em glicogenoses"
  description="Organizações com relevância direta, adjacente ou ainda não confirmada às glicogenoses. Base pública consultada dinamicamente na plataforma de dados."
  currentPath={withBase('inovacao/startups/')}
  brandPilot={true}
  favicon="brand/gsd-favicon.svg"
>
  <main id="conteudo-principal">
    <div class="container section-space stack stack--lg">
      <Breadcrumbs
        items={[
          { label: 'Início', href: '/' },
          { label: 'Inovação' },
          { label: 'Observatório de startups' },
        ]}
      />
    </div>

    <ResearchHeader
      brandPilot={true}
      eyebrow="Observatório"
      title="Observatório de startups em glicogenoses"
      summary="Mapeamento curado — não exaustivo — de organizações com relações diretas, adjacentes e de relevância ainda não confirmada às GSDs."
    />

    <StartupObservatory client:load apiBaseUrl={apiBaseUrl} />
  </main>
</BaseLayout>
