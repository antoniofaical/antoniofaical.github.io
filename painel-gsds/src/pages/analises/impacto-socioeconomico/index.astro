---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageContainer from '../../../components/layout/PageContainer.astro';
import Breadcrumbs from '../../../components/research/Breadcrumbs.astro';
import ResearchHeader from '../../../components/research/ResearchHeader.astro';
import ResearchSectionNav from '../../../components/research/ResearchSectionNav.astro';
import EvidenceFooter from '../../../components/research/EvidenceFooter.astro';
import BurdenOverview from '../../../components/socioeconomic/BurdenOverview.astro';
import CaregiverBurden from '../../../components/socioeconomic/CaregiverBurden.astro';
import CostLayers from '../../../components/socioeconomic/CostLayers.astro';
import MarketSegmentMap from '../../../components/socioeconomic/MarketSegmentMap.astro';
import MarketSizingGuardrails from '../../../components/socioeconomic/MarketSizingGuardrails.astro';
import BrazilEvidencePanel from '../../../components/socioeconomic/BrazilEvidencePanel.astro';
import EvidenceGapBridge from '../../../components/socioeconomic/EvidenceGapBridge.astro';
import { publicSocioText } from '../../../lib/copy/publicSocioText';
import { loadAnalysisEvidence } from '../../../lib/data/loadAnalysisEvidence';
import { withBase } from '../../../lib/paths/withBase';
import burdenDoc from '../../../data/socioeconomic/burden.json';
import segmentsDoc from '../../../data/socioeconomic/market-segments.json';

const evidence = loadAnalysisEvidence();
const updatedAt = '2026-08-12';
const cutoff = '2026-08-10';

const sections = [
  { id: 'carga', label: 'Carga' },
  { id: 'cuidador', label: 'Cuidador' },
  { id: 'custos', label: 'Camadas de custo' },
  { id: 'brasil', label: 'Brasil' },
  { id: 'segmentos', label: 'Segmentos' },
  { id: 'sizing', label: 'Dimensionamento' },
  { id: 'lacunas-evidencia', label: 'Lacunas' },
  { id: 'limitacoes-e-fontes', label: 'Limitações e fontes' },
];

const costDoc = evidence.costLayers;
const brazilDoc = evidence.brazilEvidence;
const observedRevenue = evidence.metrics.find((m) => m.id === 'met-market-001');
const datasusMetric = evidence.metrics.find((m) => m.id === 'met-datasus-001');
const burdenFindings = evidence.burdenFindings.filter((finding) => finding.actor !== 'caregiver');

const gapItems = evidence.marketSegments
  .filter((s) => s.observability === 'absent' || s.observability === 'conceptual-only')
  .map((s) => ({
    id: `gap-${s.id}`,
    label: `Segmento com mensuração limitada: ${s.label}`,
    detail: publicSocioText(`${s.summary} Limitação: ${s.limitations[0]}`),
  }));
---

<BaseLayout
  title="Impacto socioeconômico das glicogenoses"
  description="Carga sobre pacientes e cuidadores, camadas de custo, estrutura de mercado observada e limites da evidência brasileira."
  currentPath={withBase('analises/impacto-socioeconomico/')}
  lastReviewedAt={updatedAt}
  brandPilot={true}
  favicon="brand/gsd-favicon.svg"
>
  <main id="conteudo-principal">
    <div class="container section-space stack stack--lg">
      <Breadcrumbs
        items={[
          { label: 'Início', href: '/' },
          { label: 'Análises' },
          { label: 'Impacto socioeconômico' },
        ]}
      />
    </div>

    <ResearchHeader
      brandPilot={true}
      eyebrow="Análise socioeconômica"
      title="Impacto socioeconômico das glicogenoses"
      summary="Carga sobre pacientes, cuidadores e sistemas de saúde — e o que o mercado observado realmente captura."
      updatedAt={updatedAt}
      cutoff={cutoff}
    />

    <section class="section-space" aria-label="Sumário da página">
      <PageContainer>
        <ResearchSectionNav sections={sections} />
      </PageContainer>
    </section>

    <BurdenOverview
      title={burdenDoc.title}
      summary={publicSocioText(burdenDoc.summary)}
      findings={burdenFindings}
    />

    <CaregiverBurden findings={evidence.burdenFindings} />

    <CostLayers title={costDoc.title} summary={costDoc.summary} layers={costDoc.layers} />

    <BrazilEvidencePanel
      title={brazilDoc.title}
      summary={brazilDoc.summary}
      points={brazilDoc.points}
      datasusMetric={datasusMetric}
    />

    <MarketSegmentMap
      title={segmentsDoc.title}
      summary={publicSocioText(segmentsDoc.summary)}
      segments={evidence.marketSegments}
    />

    <MarketSizingGuardrails segments={evidence.marketSegments} observedRevenue={observedRevenue} />

    <EvidenceGapBridge items={gapItems} />

    <div id="limitacoes-e-fontes">
      <EvidenceFooter
        limitations={[
          'Contratação, preço de lista, gasto público e receita empresarial não são intercambiáveis.',
          'Ausência de dado monetário não significa mercado igual a zero.',
          'Achados de Pompe, McArdle ou GSD hepática não se generalizam a toda a família sem suporte explícito.',
          'Camadas de custo em moedas, anos e perspectivas distintas não devem ser somadas sem normalização autorizada.',
        ]}
        sources={[
          {
            title: 'Estudo Socioeconômico-Mercadológico das Glicogenoses',
          },
        ]}
      />
    </div>
  </main>
</BaseLayout>
